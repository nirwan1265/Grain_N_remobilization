#!/bin/bash
#BSUB -n 1
#BSUB -W 1:00
#BSUB -R "rusage[mem=8GB]"
#BSUB -o logs/geno.%J.%I.out
#BSUB -e logs/geno.%J.%I.err
################################################################################
## Step 4 (job array, one genome per task, ~5 min each). Submit from the OUT folder:
##   cd /share/maize/ntanduk/NMX_hsftf9_SV
##   bsub -J "geno[1-27]%10" < /share/maize/ntanduk/hpc_NMX_hsftf9_SV/04_genotype_snps.lsf
################################################################################
set -euo pipefail
OUT=${OUT:-/share/maize/ntanduk/NMX_hsftf9_SV}; SCR=${SCR:-/share/maize/ntanduk/hpc_NMX_hsftf9_SV}
cd $OUT; mkdir -p logs snp_alleles
eval "$(conda shell.bash hook)"; conda activate seqanal
G=$(sed -n "${LSB_JOBINDEX}p" genomes.txt)
python3 $SCR/04_genotype_snps.py $G $OUT
